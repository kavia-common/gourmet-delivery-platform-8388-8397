{"is_source_file": true, "format": "bash", "description": "A comprehensive shell script for automatically detecting and backing up different types of databases (SQLite, PostgreSQL, MySQL, MongoDB) used within a project environment.", "external_files": ["/usr/lib/postgresql/", "/var/run/mysqld/mysqld.sock"], "external_methods": ["ls", "cp", "sudo", "mysqladmin", "mysql", "mysqldump", "mongosh", "mongodump"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "cp \"${DB_NAME}\" \"database_backup.db\"", "sudo -u postgres ${PG_BIN}/pg_isready", "${PG_BIN}/pg_dump", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} -e \"SELECT 1\"", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mysql -h localhost -P ${DB_PORT} -u root -p${DB_PASSWORD} -e \"SELECT 1\"", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet"], "search-terms": ["backup_db.sh", "Database Backup Script", "PostgreSQL backup", "MySQL backup", "MongoDB backup", "Database detection", "SQLite check", "pg_isready", "mongosh", "mysqldump"], "state": 2, "file_id": 6, "knowledge_revision": 15, "git_revision": "411c406f863a51409242fd1396da7956010a333c", "hash": "7af9aa35fa4940f934d83f6e2621b732", "format-version": 4, "code-base-name": "database_postgresql", "filename": "database_postgresql/backup_db.sh", "revision_history": [{"15": "411c406f863a51409242fd1396da7956010a333c"}]}